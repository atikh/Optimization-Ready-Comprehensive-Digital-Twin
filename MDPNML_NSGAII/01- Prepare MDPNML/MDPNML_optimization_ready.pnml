          <parameter id="tau_remag" type="continuous" lowerBound="0.0" upperBound="20.0" baselineValue="5.0">
            <target transition="t35" transitionName="ReMAG_Idle_to_ShutDown" field="distribution.parameters.a" />
          </parameter>
          <parameter id="w_robot1" type="continuous" lowerBound="0.0" upperBound="1.0" baselineValue="0.5106082036775106">
            <target transition="t2" transitionName="Select Robot1" field="weight" />
            <complementTarget transition="t16" transitionName="Select Robot2" field="weight" />
