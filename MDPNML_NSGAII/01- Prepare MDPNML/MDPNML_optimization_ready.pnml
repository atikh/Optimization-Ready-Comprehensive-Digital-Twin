          <parameter id="tau_robot1" type="continuous" lowerBound="0.0" upperBound="20.0" baselineValue="5.0">
            <target transition="t23" transitionName="Robot1_Idle_to_ShutDown" field="distribution.parameters.a" />
          </parameter>
          <parameter id="tau_robot2" type="continuous" lowerBound="0.0" upperBound="20.0" baselineValue="5.0">
            <target transition="t26" transitionName="Robot2_Idle_to_ShutDown" field="distribution.parameters.a" />
