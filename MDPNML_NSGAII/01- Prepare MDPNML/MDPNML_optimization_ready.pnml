          <parameter id="w_mag1" type="continuous" lowerBound="0.0" upperBound="1.0" baselineValue="0.4913294797687861">
            <target transition="t4" transitionName="Select MAG1" field="weight" />
            <complementTarget transition="t11" transitionName="Select MAG2" field="weight" />
          </parameter>
        </optimizationParameters>
        <optimizationObjectives>
          <objective id="energy" source="dimension" direction="min" name="Grid" />
          <objective id="emission" source="dimension" direction="min" name="Emission" />
          <objective id="outputs" source="outputTransitions" direction="max" transitions="t8,t10,t15" transitionNames="ReWork Completed|MAG1 Completed|MAG2 Completed" />
        </optimizationObjectives>
      </optimizationModel>
    </toolspecific>
